   "path": "heEndorsementsPage.title",
   "text": "המלצות",
   "stamped": false
  },
  {
   "id": "E21",
   "file": "endorsements",
   "path": "heEndorsementsPage.intro",
   "text": "מה אמרו מי שהזמינו אותו, ומי שישבו באולם.",
   "stamped": false
  },
  {
